# nano-llm provider credentials
#
# Used by both the OpenCode plugin and the Pi extension. Neither repo ships the
# key; both resolve it from the environment at runtime.

NANO_LLM_API_KEY=replace-me

# Optional overrides
# NANO_LLM_BASE_URL=https://<your-nano-llm-endpoint>/v1
# NANO_LLM_API_KEY_ENV=NANO_LLM_API_KEY
